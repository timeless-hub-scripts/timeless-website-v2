{
  "name": "timeless-website",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "DATA",
      "id": "5a3f76187ca24434b5868628c0cce3b1"
    }
  ],
  "routes": [
    {
      "pattern": "scripts.timelesscheats.lol",
      "custom_domain": true
    }
  ]
}
